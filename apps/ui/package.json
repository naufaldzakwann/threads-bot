{
  "name": "thbuzzer-ui",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && electron-builder --win nsis",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "antd": "^5.20.0",
    "dayjs": "^1.11.12",
    "echarts": "^5.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.0",
    "react-query": "^3.39.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "id.thbuzzer.app",
    "productName": "THBuzzer",
    "win": {
      "target": [
        "nsis"
      ],
      "arch": [
        "x64"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false
    }
  }
}
